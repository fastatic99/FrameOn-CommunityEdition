<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrameonVideoUtility.Views.AudioConverterView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,28,32,34" Spacing="18">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="COMMUNITY WORKSPACE" />
        <TextBlock Text="Audio Converter" FontSize="31" FontWeight="Bold" />
        <TextBlock Classes="muted" Text="A presentation-only local audio conversion workspace ready for your own implementation." FontSize="15" />
      </StackPanel>

      <Grid ColumnDefinitions="5*,2*" ColumnSpacing="18">
        <Border Classes="workspace-card">
          <StackPanel Spacing="17">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
              <Border Classes="step-number"><TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Select audio" FontSize="17" FontWeight="SemiBold" /><TextBlock Classes="subtle" Text="Choose a local audio file to begin." /></StackPanel>
            </Grid>
            <Border Classes="placeholder-zone">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                <Border Width="52" Height="52" CornerRadius="13" Background="#2E7A48D8"><TextBlock Text="♫" FontSize="25" Foreground="{DynamicResource FrameOnAccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="No audio selected" FontSize="16" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Drag a file here or connect your own file picker." TextWrapping="Wrap" /></StackPanel>
                <Button Grid.Column="2" Content="Browse Files" VerticalAlignment="Center" ToolTip.Tip="Presentation only — add your own file picker." />
              </Grid>
            </Border>

            <Border Height="1" Background="{DynamicResource FrameOnBorderBrush}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
              <Border Classes="step-number"><TextBlock Text="2" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Output settings" FontSize="17" FontWeight="SemiBold" /><TextBlock Classes="subtle" Text="Example controls only; no encoder is included." /></StackPanel>
            </Grid>
            <StackPanel MaxWidth="280" HorizontalAlignment="Left">
              <TextBlock Classes="field-label" Text="File Format" />
              <ComboBox SelectedIndex="0"><ComboBoxItem Content="MP3" /><ComboBoxItem Content="AAC" /><ComboBoxItem Content="WAV" /><ComboBoxItem Content="FLAC" /></ComboBox>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource FrameOnBorderBrush}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
              <Border Classes="step-number"><TextBlock Text="3" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Destination" FontSize="17" FontWeight="SemiBold" /><TextBlock Classes="subtle" Text="Choose where a completed file would be saved." /></StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox PlaceholderText="Choose a destination folder" IsReadOnly="True" /><Button Grid.Column="1" Content="Browse" ToolTip.Tip="Presentation only — add your own folder picker." /></Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Clear" MinWidth="100" /><Button Classes="primary" Content="Convert Audio" MinWidth="145" IsEnabled="False" ToolTip.Tip="Connect this button to your own conversion service." /></StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Spacing="14">
          <Border Classes="workspace-card">
            <StackPanel Spacing="13">
              <TextBlock Text="Conversion Summary" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="Selected file details and output estimates can appear here." TextWrapping="Wrap" />
              <Border Height="1" Background="{DynamicResource FrameOnBorderBrush}" />
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" Text="Input" /><TextBlock Grid.Column="1" Text="—" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" Text="Duration" /><TextBlock Grid.Column="1" Text="—" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" Text="Output" /><TextBlock Grid.Column="1" Text="MP3" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" Text="Status" /><TextBlock Grid.Column="1" Classes="subtle" Text="Waiting" /></Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
