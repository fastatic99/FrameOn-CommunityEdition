<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FrameonVideoUtility.ViewModels"
        xmlns:views="using:FrameonVideoUtility.Views"
        x:Class="FrameonVideoUtility.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FrameOn Community Edition"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700"
        Background="{DynamicResource FrameOnBackgroundBrush}">
  <views:MainView />
</Window>
